+def _release_host_memory():
+    """Return large transient Ray serialization buffers to the OS."""
+    gc.collect()
+    try:
+        ctypes.CDLL("libc.so.6").malloc_trim(0)
+    except (OSError, AttributeError):
+        pass
+
+
+def _flatten_metric_values(value):
+    """Flatten per-chunk, per-rank metric values for the standard reducer."""
+    if isinstance(value, np.ndarray):
+        value = value.tolist()
+    if isinstance(value, (list, tuple)):
+        flattened = []
+        for item in value:
+            flattened.extend(_flatten_metric_values(item))
+        return flattened
+    return [value]
+
