@@ -0,0 +1,52 @@
+import math
+
+import torch
+
+from verl.trainer.ppo.counterfactual_reward import (
+    calibrate_from_sequence_kl,
+    counterfactual_reward_scale,
+    reverse_k3_sequence_kl,
+)
+
+
+def test_reverse_k3_is_nonnegative_masked_mean_and_detached():
+    original = torch.tensor([[0.0, -2.0, 5.0], [-1.0, -1.0, -1.0]], requires_grad=True)
+    view = torch.tensor([[-1.0, -1.0, 4.0], [-1.0, -2.0, -3.0]], requires_grad=True)
+    mask = torch.tensor([[1, 1, 0], [1, 1, 1]])
+
+    sequence, token = reverse_k3_sequence_kl(
+        original_log_probs=original,
+        view_log_probs=view,
+        response_mask=mask,
+    )
+
+    assert torch.all(token >= 0)
+    assert torch.all(sequence >= 0)
+    assert torch.allclose(sequence[0], token[0, :2].mean())
+    assert not sequence.requires_grad
+    assert not token.requires_grad
+
+
+def test_stage_rewards_keep_wrong_answers_zero_and_respect_bounds():
+    kl = torch.tensor([0.0, 1.0, 100.0])
+    accuracy = torch.tensor([1.0, 0.0, 1.0])
+    s1 = accuracy * counterfactual_reward_scale(
+        kl, stage="stage1", coefficient=0.3, power=2.0, tau=1.0
+    )
+    s2 = accuracy * counterfactual_reward_scale(
+        kl, stage="stage2", coefficient=0.3, alpha=math.log(2.0)
+    )
+
+    assert torch.all((s1[accuracy == 1] >= 0.7) & (s1[accuracy == 1] <= 1.0))
+    assert s1[1] == 0
+    assert torch.all((s2[accuracy == 1] >= 1.0) & (s2[accuracy == 1] <= 1.3))
+    assert s2[1] == 0
+
+
+def test_calibration_uses_selected_half_saturation_quantile():
+    values = torch.tensor([1.0, 2.0, 3.0])
+    s1 = calibrate_from_sequence_kl(values, stage="stage1", quantile=0.5)
+    s2 = calibrate_from_sequence_kl(values, stage="stage2", quantile=0.5)
+
+    assert s1["tau1"] == 2.0
+    assert math.isclose(s2["alpha2"], math.log(2.0) / 2.0)
