+"""Counterfactual RLVR reward utilities.
+
+The rollout is sampled from the stage view policy q (preserved or ablated).
+For every sampled response token we also evaluate the original-view policy p.
+The reverse-k3 estimator
+
+    r * log(r) - r + 1,  r = p(a|s) / q(a|s)
+
+is pointwise non-negative and has expectation KL(p || q) over actions a~q
+at each encountered prefix.  Sequence values are response-token means so that
+response length does not silently change the reward scale.
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+from pathlib import Path
+
+import torch
+
+
+def reverse_k3_sequence_kl(
+    *,
+    original_log_probs: torch.Tensor,
+    view_log_probs: torch.Tensor,
+    response_mask: torch.Tensor,
+    log_ratio_clip: float = 20.0,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return detached sequence-mean and token reverse-k3 KL estimates.
+
+    ``original_log_probs`` is log pi^o and ``view_log_probs`` is log pi^view
+    for tokens sampled from pi^view. Clipping only protects exponentiation;
+    it introduces a small estimator bias for extreme ratios.
+    """
+    if original_log_probs.shape != view_log_probs.shape:
+        raise ValueError(
+            f"log-prob shapes differ: {original_log_probs.shape=} {view_log_probs.shape=}"
+        )
+    if response_mask.shape != view_log_probs.shape:
+        raise ValueError(f"mask shape differs: {response_mask.shape=} {view_log_probs.shape=}")
+    if log_ratio_clip <= 0:
+        raise ValueError(f"log_ratio_clip must be positive, got {log_ratio_clip}")
+
+    # float64 keeps exp(d) * d - exp(d) + 1 accurate around d=0. The result is
+    # returned in float32 because it is a detached reward statistic.
+    d = (original_log_probs.double() - view_log_probs.double()).clamp(
+        min=-log_ratio_clip, max=log_ratio_clip
+    )
+    ratio = torch.exp(d)
+    token_kl = (ratio * d - ratio + 1.0).clamp_min(0.0)
+    mask = response_mask.to(dtype=token_kl.dtype)
+    sequence_kl = (token_kl * mask).sum(dim=-1) / mask.sum(dim=-1).clamp_min(1.0)
+    return sequence_kl.float().detach(), token_kl.float().detach()
+
+
+def counterfactual_reward_scale(
+    sequence_kl: torch.Tensor,
+    *,
+    stage: str,
+    coefficient: float,
+    power: float = 2.0,
+    tau: float | None = None,
+    alpha: float | None = None,
+) -> torch.Tensor:
+    """Compute the fixed Stage-1 or Stage-2 nonlinear reward multiplier."""
+    if not 0.0 <= coefficient <= 1.0:
+        raise ValueError(f"coefficient must be in [0, 1], got {coefficient}")
+    if stage == "stage1":
+        if tau is None or tau <= 0:
+            raise ValueError(f"Stage 1 requires tau > 0, got {tau}")
+        if power <= 1:
+            raise ValueError(f"Stage 1 requires power > 1, got {power}")
+        normalized_power = (sequence_kl / tau).clamp_min(0.0).pow(power)
+        mapped = normalized_power / (1.0 + normalized_power)
+        return (1.0 - coefficient * mapped).detach()
+    if stage == "stage2":
+        if alpha is None or alpha <= 0:
+            raise ValueError(f"Stage 2 requires alpha > 0, got {alpha}")
+        mapped = -torch.expm1(-alpha * sequence_kl.clamp_min(0.0))
+        return (1.0 + coefficient * mapped).detach()
+    raise ValueError(f"unknown counterfactual reward stage: {stage!r}")
+
+
+def calibrate_from_sequence_kl(
+    sequence_kl: torch.Tensor,
+    *,
+    stage: str,
+    quantile: float = 0.5,
+    minimum_scale: float = 1e-8,
+) -> dict[str, float | int | str | dict[str, float]]:
+    """Choose tau/alpha from a KL distribution with a recorded rule.
+
+    The selected quantile is the half-saturation point for both mappings:
+    tau = Q for Stage 1 and alpha = ln(2)/Q for Stage 2.
+    """
+    if not 0.0 < quantile < 1.0:
+        raise ValueError(f"quantile must be in (0, 1), got {quantile}")
+    values = sequence_kl.detach().double().cpu()
+    values = values[torch.isfinite(values)]
+    if values.numel() == 0:
+        raise ValueError("cannot calibrate from an empty/non-finite KL distribution")
+    qs = {
+        "q10": float(torch.quantile(values, 0.10)),
+        "q25": float(torch.quantile(values, 0.25)),
+        "q50": float(torch.quantile(values, 0.50)),
+        "q75": float(torch.quantile(values, 0.75)),
+        "q90": float(torch.quantile(values, 0.90)),
+        "q95": float(torch.quantile(values, 0.95)),
+        "q99": float(torch.quantile(values, 0.99)),
+    }
+    selected = max(float(torch.quantile(values, quantile)), minimum_scale)
+    result: dict[str, float | int | str | dict[str, float]] = {
+        "stage": stage,
+        "sample_count": int(values.numel()),
+        "selection_quantile": float(quantile),
+        "half_saturation_kl": selected,
+        "mean": float(values.mean()),
+        "std": float(values.std(unbiased=False)),
+        "min": float(values.min()),
+        "max": float(values.max()),
+        "quantiles": qs,
+    }
+    if stage == "stage1":
+        result["tau1"] = selected
+    elif stage == "stage2":
+        result["alpha2"] = math.log(2.0) / selected
+    else:
+        raise ValueError(f"unknown calibration stage: {stage!r}")
+    return result
+
+
+def write_calibration_json(path: str | os.PathLike[str], result: dict) -> None:
+    """Atomically write a calibration artifact."""
+    target = Path(path).expanduser().resolve()
+    target.parent.mkdir(parents=True, exist_ok=True)
+    temporary = target.with_name(f".{target.name}.incomplete")
+    temporary.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    os.replace(temporary, target)
